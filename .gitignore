/target
.DS_Store
.claude/

# Raw benchmark result TOMLs carry full per-run solution vectors and are huge
# (100s of MB per large-band file). Only the slim summaries + index.json are
# version-controlled and served by the viewer; regenerate slims locally with
# `python3 docs/benchmarks/render.py`.
docs/benchmarks/data/**/*.toml
!docs/benchmarks/data/**/*.slim.toml

# `mkdocs build`'s default output directory (CI builds into _site instead).
/site

# rustdoc output, copied into the site source so the Markdown can link to it
# with checked relative paths. Regenerate with `cargo doc --no-deps --lib`
# (`--lib` avoids the lib/bin output-filename collision) and copy target/doc
# here before building the site.
/docs/api/
